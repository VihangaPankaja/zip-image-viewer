{
  "name": "zip-image-viewer",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --configLoader runner",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:server && pnpm run typecheck:tests",
    "typecheck:client": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build --configLoader runner",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner",
    "test:unit": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner client/src/lib client/src/features/player server/domain server/contracts server/application server/infrastructure server/media",
    "test:integration": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner --project unit-integration server/bootstrap tests/integration",
    "test:component": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner --project component client/src/components client/src/features",
    "test:ui": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner --project component client/src/pages client/src/App.test.tsx",
    "test:watch": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs --configLoader runner",
    "test:coverage": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --configLoader runner --coverage",
    "test:related": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs related --configLoader runner --run",
    "test:e2e": "playwright test",
    "start": "node build/server/index.js",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json --min-score 80 --score",
    "fallow:audit": "fallow audit --base origin/master --gate new-only --brief",
    "fallow:dead": "fallow dead-code",
    "fallow:duplicates": "fallow dupes --fail-on-issues",
    "fallow:coverage-gaps": "fallow health --coverage-gaps --report-only",
    "fallow:targets": "fallow health --targets --report-only",
    "fallow:fix:dry-run": "fallow fix --dry-run",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run fallow:dead && pnpm run fallow:duplicates && pnpm run fallow:health && pnpm run build"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/react-query": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@tanstack/react-query": "^5.102.8",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.0.2",
    "got": "^16.0.0",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.41.0",
    "mime-types": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "sharp": "^0.35.4",
    "unzipper": "^0.12.5",
    "webtorrent": "3.0.21",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "@types/webtorrent": "3.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@zip-image-viewer/eslint-config": "workspace:*",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "fallow": "^3.22.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

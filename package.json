{
  "name": "zip-image-viewer",
  "version": "3.28.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec concurrently \"vpr dev:server\" \"vpr dev:client\"",
    "dev:server": "vp exec tsx watch server/index.ts",
    "dev:client": "vp dev",
    "lint": "vp lint && vpr lint:css",
    "lint:css": "vp exec stylelint \"client/src/**/*.css\" --max-warnings 0",
    "typecheck": "vp check --no-fmt --no-lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build": "vpr build:client && vpr build:server",
    "build:client": "vp build",
    "build:server": "vp exec tsc -p tsconfig.server.json",
    "test": "vp test",
    "test:unit": "vp test tests/unit tooling",
    "test:integration": "vp test tests/integration",
    "test:component": "vp test --project component tests/component",
    "test:ui": "vp test --project component tests/ui",
    "test:watch": "vp test watch",
    "test:coverage": "vp test --coverage",
    "test:related": "vp test related --run",
    "test:e2e": "vp exec playwright test",
    "dependencies:report": "vp exec node tooling/dependency-report.mjs",
    "benchmark:video": "vp exec tsx tests/benchmarks/videoLatency.ts",
    "benchmark:encoding": "vp exec tsx tests/benchmarks/videoEncoding.ts",
    "benchmark:storyboard": "vp exec tsx tests/benchmarks/videoStoryboard.ts",
    "benchmark:seek": "vp exec playwright test --config playwright.seek.config.ts",
    "start": "node build/server/index.js",
    "fallow:health": "vp exec fallow health --coverage coverage/coverage-final.json --score --report-only",
    "fallow:audit": "vp exec fallow audit --base origin/master --gate new-only --brief",
    "fallow:dead": "vp exec fallow dead-code",
    "fallow:duplicates": "vp exec fallow dupes --fail-on-issues",
    "fallow:targets": "vp exec fallow health --targets --report-only",
    "fallow:fix:dry-run": "vp exec fallow fix --dry-run",
    "quality": "vp check && vpr lint:css && vpr test:coverage && vpr fallow:dead && vpr fallow:duplicates && vpr fallow:health && vpr build",
    "prepare": "vp config --no-agent",
    "check": "vp check && vpr lint:css",
    "test:lint": "vp test tests/integration/toolchainLint.test.ts"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@orpc/client": "^1.15.7",
    "@orpc/contract": "^1.15.7",
    "@orpc/react-query": "^1.15.7",
    "@orpc/server": "^1.15.7",
    "@tanstack/react-query": "^5.104.4",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.2.0",
    "got": "^16.1.0",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.59.0",
    "mime-types": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.5",
    "webtorrent": "3.0.21",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "@types/webtorrent": "3.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^10.0.5",
    "fallow": "^3.22.0",
    "jsdom": "^30.0.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.1.0"
}
